# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID тех, кто может пользоваться ботом (через запятую).
# Свой ID покажет команда /id у запущенного бота.
ADMIN_IDS=

# Канал для публикации: @username канала или числовой ID (-100...).
# Бот должен быть добавлен в канал администратором с правом публикации.
CHANNEL_ID=

# 1 = сразу публиковать заполненную одиночную карточку, 0 = показать черновик
AUTO_POST=0

# Необязательный HTTP-прокси для запросов Ozon и его изображений
OZON_PROXY=

# Регион цен Wildberries (по умолчанию Москва)
WB_DEST=-1257786

# 1 = если WB не отдаёт общую цену, запросить её у WBCON. 0 = только сама витрина.
WB_PRICE_FALLBACK=1

# Свободные слоты очереди по Москве
QUEUE_SLOTS=10:00,13:00,16:00,19:00

# Проверка цен опубликованных товаров примерно раз в сутки
PRICE_MONITOR=1
PRICE_DROP_PERCENT=15

# Необязательные параметры из кабинета партнёрской программы
WB_AFFILIATE_PARAMS=
OZON_AFFILIATE_PARAMS=

# Необязательный публичный HTTPS-адрес для перенаправлений /go/
CLICK_BASE_URL=
CLICK_BIND_HOST=127.0.0.1
CLICK_PORT=8088

# Если публичная карточка Ozon неполная, искать поля по SKU в WBCON. 0 отключает автообращение.
OZON_PRICE_FALLBACK=1

# Необязательные ключи BHAPI с доступом к соответствующей площадке.
# При заданном ключе импорт и /diag неполных карточек могут расходовать квоту.
BHAPI_OZON_TOKEN=
BHAPI_WB_TOKEN=

# Необязательный HTTP/SOCKS прокси для запросов к WB и его изображениям
WB_PROXY=

# 0 оставляет одиночное фото без оформления и убирает цветные плашки в подборках
IMAGE_BADGES=1

# Запросы к Ozon и WB с отпечатком Chrome (нужен curl_cffi из requirements-ozon.txt).
# Ozon режет обычный httpx по отпечатку TLS. 0 возвращает прежний httpx.
HTTP_IMPERSONATE=1
# Профиль браузера для отпечатка. Менять нужно только по подсказке из /diag.
HTTP_IMPERSONATE_TARGET=chrome

# Необязательно (v10): название и фото из превью ссылки, которое построил Telegram.
# Помогает, когда Ozon закрыл страницу для адреса телефона, а в чате превью видно.
# Ключи выдаёт my.telegram.org → API development tools (регистрация приложения владельцем).
# Вход выполняется токеном бота. Нужна библиотека: .venv/bin/python -m pip install -r requirements-preview.txt
# Файл tg_preview.session — секрет, никому не пересылайте.
TG_API_ID=
TG_API_HASH=
